#!/usr/bin/env bash
# README.md 나 그림이 바뀐 커밋이면 PDF 매뉴얼을 다시 뽑아 같은 커밋에 넣는다.
# 켜기 (한 번만):  git config core.hooksPath .githooks
# Chrome 이 없는 PC(예: WSL)에서는 조용히 건너뛴다 — 그때는 GitHub Actions 가 대신 뽑는다.
ROOT="$(git rev-parse --show-toplevel)"
changed="$(git diff --cached --name-only)"
echo "$changed" | grep -qE '^(README\.md|docs/img/|tools/docs/)' || exit 0
out="$(bash "$ROOT/tools/docs/pdf_sync.sh" 2>&1)"; rc=$?
echo "$out" | sed 's/^/[pre-commit] /'
if echo "$out" | grep -q "Chrome / Chromium / Edge 를 찾을 수 없습니다"; then
  echo "[pre-commit] 브라우저 없음 — PDF 는 GitHub Actions 가 push 후에 갱신합니다"; exit 0
fi
[ $rc -ne 0 ] && { echo "[pre-commit] PDF 생성 실패 — 커밋은 계속합니다"; exit 0; }
while read -r md pdf; do
  case "$md" in ''|\#*) continue ;; esac
  [ -f "$ROOT/$pdf" ] && git add "$ROOT/$pdf"
done < "$ROOT/tools/docs/pdf_targets.txt"
exit 0
